# Copy to `.env` and fill in for production. Local dev needs nothing here —
# if R2_BUCKET is unset, the app falls back to ./uploads on local disk.

# Optional — defaults to 3000.
# PORT=3000

# ─── Cloudflare R2 ──────────────────────────────────────────────
# Get these from the Cloudflare dashboard → R2 → your bucket.
#
# 1. Create a bucket (e.g. "wedding-photos").
# 2. R2 → "Manage R2 API Tokens" → create an "Object Read & Write" token
#    scoped to that bucket. Save the access key + secret.
# 3. Bucket → Settings → "Public access" → enable r2.dev (quickest) or
#    attach a custom domain like photos.yoursite.com.
# 4. R2_PUBLIC_URL is whatever URL the bucket serves files from
#    (https://pub-xxxx.r2.dev  OR  https://photos.yoursite.com).
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
